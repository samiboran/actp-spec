{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://actp-spec.org/schema/v0.1.3.json",
  "title": "ACTP Package Schema v0.1.3",
  "description": "Agent Context Transfer Protocol - Artifact packaging format for AI agents",
  "type": "object",
  "required": [
    "version",
    "project_name",
    "generated_at",
    "files",
    "metadata"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver format: major.minor.patch"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the packaged project"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "files": {
      "type": "array",
      "description": "List of files in the package",
      "items": {
        "type": "object",
        "required": [
          "path",
          "content",
          "size",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)[^/\\\\][^\\x00]*$",
            "description": "Relative path, no .. segments, no absolute paths"
          },
          "content": {
            "type": "string",
            "description": "UTF-8 file content"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Content length in bytes"
          },
          "type": {
            "type": "string",
            "description": "File type: python, javascript, markdown, etc."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Optional SHA-256 checksum (hex, lowercase)"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "total_files",
        "total_tokens_estimate"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Directories excluded during packaging"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-fatal warnings (secrets, size limits, etc.)"
        },
        "generator": {
          "type": "string",
          "description": "Tool that generated this package, e.g. 'actp-cli/0.1.3'"
        }
      }
    }
  }
}