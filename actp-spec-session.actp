    {
      "path": "cli/context.actp.json",
      "content": "{\n  \"@context\": \"https://actp.dev/schema/v0.1\",\n  \"@type\": \"ACTPPacket\",\n  \"actp_version\": \"0.1\",\n  \"created_at\": \"2026-04-13T23:53:14.683Z\",\n  \"source_model\": \"claude\",\n  \"vocabulary_hash\": \"actp-legend-v0.1\",\n  \"symbol_legend\": {\n    \"P0\": \"priority=P0, mutability=LOCKED, certainty=HIGH\",\n    \"P1\": \"priority=P1, mutability=FLEXIBLE, certainty=MEDIUM\",\n    \"P2\": \"priority=P2, mutability=FLEXIBLE, certainty=LOW\",\n    \"COMPLETED\": \"status=COMPLETED\",\n    \"LOW_CERTAINTY\": \"certainty=LOW, hallucination_risk=true\",\n    \"EXTERNAL\": \"external_dependency=true\"\n  },\n  \"project\": {\n    \"name\": \"actp-spec\",\n    \"goal\": \"Portable AI context transfer protocol\",\n    \"constraints\": [],\n    \"soft_preferences\": []\n  },\n  \"decisions\": [\n    {\n      \"id\": \"D1\",\n      \"content\": \"Use fetch() only, no SDKs\",\n      \"priority\": \"P0\",\n      \"symbol\": \"P0\",\n      \"source\": \"actp capture\"\n    }\n  ],\n  \"tasks\": [],\n  \"open_questions\": [],\n  \"next_steps\": [],\n  \"integrity_hash\": \"cc7c6f9894a3fb9322943951ae9e8731c92a3abc0b9efe8f16749d8586a6e7f7\"\n}",
