    {
      "path": "actp.schema.json",
      "content": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"https://actp.dev/schema/v0.1/actp.schema.json\",\n  \"title\": \"ACTP — AI Context Transfer Protocol\",\n  \"description\": \"Schema for portable AI context packets. Model-agnostic, user-owned, semantic-first.\",\n  \"version\": \"0.1\",\n  \"type\": \"object\",\n  \"required\": [\n    \"@context\",\n    \"@type\",\n    \"actp_version\",\n    \"created_at\",\n    \"vocabulary_hash\",\n    \"symbol_legend\",\n    \"project\",\n    \"decisions\"\n  ],\n  \"properties\": {\n    \"@context\": {\n      \"type\": \"string\",\n      \"const\": \"https://actp.dev/schema/v0.1\",\n      \"description\": \"JSON-LD context namespace. Must match this value for v0.1.\"\n    },\n    \"@type\": {\n      \"type\": \"string\",\n      \"const\": \"ACTPPacket\",\n      \"description\": \"Packet type identifier.\"\n    },\n    \"actp_version\": {\n      \"type\": \"string\",\n      \"const\": \"0.1\",\n      \"description\": \"Protocol version.\"\n    },\n    \"created_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"ISO8601 timestamp of packet creation.\"\n    },\n    \"source_model\": {\n      \"type\": \"string\",\n      \"enum\": [\"claude\", \"chatgpt\", \"gemini\", \"other\"],\n      \"description\": \"AI model that generated this packet.\"\n    },\n    \"vocabulary_hash\": {\n      \"type\": \"string\",\n      \"description\": \"Version identifier for the symbol_legend. If hash changes, receiving model must re-sync legend before processing payload.\"\n    },\n    \"symbol_legend\": {\n      \"type\": \"object\",\n      \"description\": \"Defines the symbolic encoding vocabulary for this packet. Always embed — never assume the receiver knows the legend.\",\n      \"properties\": {\n        \"🔴\": { \"type\": \"string\", \"const\": \"priority=P0, mutability=LOCKED, certainty=HIGH\" },\n        \"🟡\": { \"type\": \"string\", \"const\": \"priority=P1, mutability=FLEXIBLE, certainty=MEDIUM\" },\n        \"🔵\": { \"type\": \"string\", \"const\": \"priority=P2, mutability=FLEXIBLE, certainty=LOW\" },\n        \"🟢\": { \"type\": \"string\", \"const\": \"status=COMPLETED\" },\n        \"🌫️\": { \"type\": \"string\", \"const\": \"certainty=LOW, hallucination_risk=true\" },\n        \"🔗\": { \"type\": \"string\", \"const\": \"external_dependency=true\" }\n      }\n    },\n    \"project\": {\n      \"type\": \"object\",\n      \"required\": [\"name\", \"goal\"],\n      \"description\": \"Top-level project descriptor — the apex of the context hierarchy.\",\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\",\n          \"description\": \"Project name.\"\n        },\n        \"goal\": {\n          \"type\": \"string\",\n          \"description\": \"One sentence. What is this project trying to achieve?\"\n        },\n        \"constraints\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"🔴 Immutable constraints. These must never be overridden by any model.\"\n        },\n        \"soft_preferences\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"🟡 Flexible preferences. Can be adjusted if justified.\"\n        }\n      }\n    },\n    \"decisions\": {\n      \"type\": \"array\",\n      \"description\": \"Decisions made during this project. Core of the context packet.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"priority\", \"certainty\", \"mutability\", \"content\"],\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"description\": \"Unique decision ID (e.g. D1, D2).\" },\n          \"symbol\": { \"type\": \"string\", \"description\": \"Optional human-readable symbol from legend.\" },\n          \"priority\": { \"type\": \"string\", \"enum\": [\"P0\", \"P1\", \"P2\"], \"description\": \"P0=critical, P1=high, P2=low.\" },\n          \"certainty\": { \"type\": \"string\", \"enum\": [\"HIGH\", \"MEDIUM\", \"LOW\"] },\n          \"mutability\": { \"type\": \"string\", \"enum\": [\"LOCKED\", \"FLEXIBLE\"], \"description\": \"LOCKED decisions must not be changed without human approval.\" },\n          \"content\": { \"type\": \"string\", \"description\": \"The decision itself.\" },\n          \"rationale\": { \"type\": \"string\", \"description\": \"Why this decision was made.\" },\n          \"source_model\": { \"type\": \"string\", \"description\": \"Which model made this decision.\" },\n          \"hallucination_risk\": { \"type\": \"boolean\", \"default\": false, \"description\": \"🌫️ Flag if this content has low certainty.\" },\n          \"external_dependency\": { \"type\": \"boolean\", \"default\": false, \"description\": \"🔗 Flag if this relies on external file or API not in packet.\" }\n        }\n      }\n    },\n    \"tasks\": {\n      \"type\": \"array\",\n      \"description\": \"Current task list and status.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"status\", \"description\"],\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"status\": { \"type\": \"string\", \"enum\": [\"done\", \"pending\", \"blocked\"] },\n          \"description\": { \"type\": \"string\" },\n          \"symbol\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"artifacts\": {\n      \"type\": \"object\",\n      \"description\": \"Code, files, and references relevant to the project state.\",\n      \"properties\": {\n        \"code_snippets\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\"id\", \"lang\"],\n            \"properties\": {\n              \"id\": { \"type\": \"string\" },\n              \"lang\": { \"type\": \"string\" },\n              \"content\": { \"type\": [\"string\", \"null\"], \"description\": \"Snippet content. Null when content is deduplicated into files[].\" },\n              \"summary\": { \"type\": \"string\" }\n            }\n          }\n        },\n        \"references\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"URLs or filenames. Mark with 🔗 if external dependency.\"\n        },\n        \"code_graph_ref\": {\n          \"type\": \"object\",\n          \"description\": \"Optional reference to a precomputed structural code graph (e.g. Graphify output). Complements ACTP's declarative decision memory with structural/dependency memory. Only a reference is stored — never the graph itself — to keep packets lightweight.\",\n          \"required\": [\"tool\", \"graph_path\"],\n          \"properties\": {\n            \"tool\": {\n              \"type\": \"string\",\n              \"description\": \"Name of the graph-generation tool used.\",\n              \"examples\": [\"graphify\"]\n            },\n            \"graph_path\": {\n              \"type\": \"string\",\n              \"description\": \"Relative path to the graph file (e.g. graph.json) within the project.\"\n            },\n            \"graph_hash\": {\n              \"type\": \"string\",\n              \"description\": \"SHA-256 hash of the graph file. Used by the receiving model to detect staleness before trusting the reference.\"\n            },\n            \"generated_at\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\",\n              \"description\": \"Timestamp when the graph was last built.\"\n            },\n            \"node_count\": {\n              \"type\": \"integer\",\n              \"description\": \"Number of nodes in the graph. Below ~500 files, consumers may reasonably skip resolving this reference since the graph adds more overhead than value at small scale.\"\n            }\n          }\n        }\n      }\n    },\n    \"entity_map\": {\n      \"type\": \"object\",\n      \"description\": \"Canonical name registry. Prevents naming drift across models and sessions.\",\n      \"additionalProperties\": { \"type\": \"string\" }\n    },\n    \"priority_matrix\": {\n      \"type\": \"array\",\n      \"description\": \"Attention steering weights. Tells the receiving model which segments to prioritize.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"segment\", \"weight\"],\n        \"properties\": {\n          \"segment\": { \"type\": \"string\" },\n          \"weight\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 }\n        }\n      }\n    },\n    \"open_questions\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Unresolved questions that the receiving model should be aware of.\"\n    },\n    \"next_steps\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Ordered list of actions to take next.\"\n    },\n    \"dead_letter\": {\n      \"type\": \"array\",\n      \"description\": \"Quarantined context that could not be rehydrated. Do not discard — preserve for debugging.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"reason\": { \"type\": \"string\" },\n          \"original\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"integrity_hash\": {\n      \"type\": \"string\",\n      \"description\": \"SHA-256 hash of all content fields. Used to verify packet integrity on import.\"\n    }\n  }\n}",
