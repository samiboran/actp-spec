    {
      "path": "python/tests/ai_test_questions.json",
      "content": "{\n  \"actp_ai_test_questions\": {\n    \"metadata\": {\n      \"version\": \"1.0\",\n      \"created_at\": \"2026-07-21T12:00:00Z\",\n      \"protocol\": \"ACTP v0.1\",\n      \"purpose\": \"Comprehensive AI testing for ACTP deduplikasyon, round-trip, validator, güvenlik\",\n      \"target_models\": [\"claude\", \"gpt-4\", \"gemini\"],\n      \"difficulty_levels\": {\n        \"basic\": \"Fonksiyonellik doğrulama\",\n        \"intermediate\": \"Integration ve edge cases\",\n        \"advanced\": \"Güvenlik, performans, deterministik davranış\"\n      }\n    },\n    \"test_suites\": {\n      \"deduplikasyon\": {\n        \"name\": \"✂️ Deduplikasyon Testleri\",\n        \"description\": \"Content tekrarı %95 → 0% olup olmadığını doğrula\",\n        \"questions\": [\n          {\n            \"id\": \"dedup_001\",\n            \"difficulty\": \"basic\",\n            \"question\": \"ACTP paketinde `files[]` ve `code_snippets[]` arasında veri tekrarı var mı? Nasıl tespit edebilirim?\",\n            \"context\": {\n              \"scenario\": \"10 Python dosyası paketlenmiş\",\n              \"files_count\": 10,\n              \"code_snippets_count\": 10\n            },\n            \"expected_answer\": \"files[]'de tam içerik, code_snippets[]'de content=null olmalı. Veri tekrarı sıfır olmalı.\",\n            \"test_assertion\": \"all(s.content is None for s in packet.artifacts.code_snippets)\",\n            \"test_metric\": \"snippets_size = 0 bytes\"\n          },\n          {\n            \"id\": \"dedup_002\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Deduplikasyon uygulandığında paket boyutu ne kadar küçülüyor? JSON dump boyutunu ölç.\",\n            \"context\": {\n              \"scenario\": \"50 dosya x 100KB = 5MB veri\",\n              \"measure\": \"JSON serialized size\"\n            },\n            \"expected_answer\": \"Orijinal boyutun ~50% veya daha az (1-3MB)\",\n            \"test_assertion\": \"json_size < original_files_size * 1.5\",\n            \"test_metric\": \"compression_ratio = json_size / files_total_size\"\n          },\n          {\n            \"id\": \"dedup_003\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Mixed file türleri (py, txt, md, json) paketlenince deduplikasyon nasıl uygulanıyor? Hangi dosyalar `code_snippets[]`'e giriyor?\",\n            \"context\": {\n              \"files\": [\"main.py\", \"notes.txt\", \"README.md\", \"config.json\"],\n              \"expected_snippets\": 1\n            },\n            \"expected_answer\": \".py dosyaları code_snippets[]'e girer, diğerleri files[]'de kalır. Sadece code files deduplicate edilir.\",\n            \"test_assertion\": \"len(code_snippets) == 1 and all(s.content is None for s in code_snippets)\",\n            \"test_metric\": \"code_files_ratio = 1/4 = 25%\"\n          }\n        ]\n      },\n      \"round_trip\": {\n        \"name\": \"🔄 Round-Trip (Pack-Unpack) Testleri\",\n        \"description\": \"Pack → Save → Unpack → Verify workflow\",\n        \"questions\": [\n          {\n            \"id\": \"round_001\",\n            \"difficulty\": \"basic\",\n            \"question\": \"Pack→Unpack döngüsünde dosya içeriği birebir korunuyor mu? 10 dosyayı kontrol et.\",\n            \"context\": {\n              \"files\": {\n                \"main.py\": \"def main(): print('Hello')\",\n                \"utils.py\": \"def helper(): return 42\",\n                \"README.md\": \"# My Project\",\n                \"config.json\": \"{\\\"version\\\": \\\"1.0\\\"}\"\n              },\n              \"count\": 4\n            },\n            \"expected_answer\": \"Tüm dosyalar aynı içerikle geri yüklenmeli. Checksum eşleşmeli.\",\n            \"test_assertion\": \"all(restored_content == original_content for file in files)\",\n            \"test_metric\": \"success_rate = 100%\"\n          },\n          {\n            \"id\": \"round_002\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"İç içe dizin yapısı (src/main/, src/utils/, tests/, docs/) restore ediliyor mu? Tüm yollar korunuyor mu?\",\n            \"context\": {\n              \"directories\": [\n                \"src/main/app.py\",\n                \"src/utils/helper.py\",\n                \"tests/test_app.py\",\n                \"docs/README.md\"\n              ],\n              \"depth\": 4\n            },\n            \"expected_answer\": \"Tüm dizin yapısı korunmalı. Nested paths tam olarak restore edilmeli.\",\n            \"test_assertion\": \"all((restore_dir / expected_path).exists() for expected_path in directories)\",\n            \"test_metric\": \"path_integrity = 100%\"\n          },\n          {\n            \"id\": \"round_003\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Checksum integriteşi round-trip sonrası korunuyor mu? Orijinal ve restore dosyalarının SHA-256'ları eşleşiyor mu?\",\n            \"context\": {\n              \"large_file\": \"10MB text file\",\n              \"checksum_algo\": \"SHA-256\",\n              \"test_count\": 50\n            },\n            \"expected_answer\": \"Her file için original_checksum == restored_checksum\",\n            \"test_assertion\": \"checksum1 == checksum2 for all files\",\n            \"test_metric\": \"checksum_match_rate = 100%\"\n          },\n          {\n            \"id\": \"round_004\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Unicode karakterler (🚀, 世界, ™, ∫) round-trip'te korunuyor mu?\",\n            \"context\": {\n              \"unicode_content\": \"def greet(name='世界'): return f'Hello {name}! 🚀'\",\n              \"special_chars\": [\"emoji\", \"CJK\", \"symbols\", \"math\"]\n            },\n            \"expected_answer\": \"Unicode tam olarak korunmalı. UTF-8 encoding preserve edilmeli.\",\n            \"test_assertion\": \"restored_unicode == original_unicode\",\n            \"test_metric\": \"unicode_preservation = 100%\"\n          }\n        ]\n      },\n      \"validator\": {\n        \"name\": \"✅ Validator Testleri\",\n        \"description\": \"Schema, enum, checksum, vocabulary_hash doğrulama\",\n        \"questions\": [\n          {\n            \"id\": \"val_001\",\n            \"difficulty\": \"basic\",\n            \"question\": \"Validator geçersiz decision priority'yi yakalar mı? 'MEGA_CRITICAL' gibi invalid enum.\",\n            \"context\": {\n              \"invalid_priority\": \"MEGA_CRITICAL\",\n              \"valid_priorities\": [\"P0\", \"P1\", \"P2\"]\n            },\n            \"expected_answer\": \"Validator reject etmeli, error mesajı dönmeli.\",\n            \"test_assertion\": \"is_valid is False and 'priority' in errors\",\n            \"test_metric\": \"validation_accuracy = 100%\"\n          },\n          {\n            \"id\": \"val_002\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Checksum uyuşmazlığı tespit ediliyor mu? Content değiştirilip checksum eski kalırsa?\",\n            \"context\": {\n              \"original_content\": \"original\",\n              \"modified_content\": \"MODIFIED\",\n              \"checksum\": \"original'in SHA-256\"\n            },\n            \"expected_answer\": \"Validator checksum mismatch'i tespit etmeli.\",\n            \"test_assertion\": \"is_valid is False and 'checksum' in errors\",\n            \"test_metric\": \"tampering_detection = 100%\"\n          },\n          {\n            \"id\": \"val_003\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Vocabulary hash uyuşmazlığı tespit ediliyor mu? Symbol legend değiştirilirse?\",\n            \"context\": {\n              \"symbol_legend\": {\"🔴\": \"Critical\"},\n              \"vocabulary_hash\": \"actual_hash_of_legend\"\n            },\n            \"expected_answer\": \"Validator hash mismatch'i tespit etmeli.\",\n            \"test_assertion\": \"is_valid is False and 'vocabulary_hash' in errors\",\n            \"test_metric\": \"semantic_integrity = 100%\"\n          },\n          {\n            \"id\": \"val_004\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Bozuk paket reddediliyor mu? files string ise, checksum null ise?\",\n            \"context\": {\n              \"corruptions\": [\n                \"files = 'string' (array yerine)\",\n                \"checksum = null\",\n                \"checksum = ''\",\n                \"files = None\"\n              ]\n            },\n            \"expected_answer\": \"Tüm bozuk paketler reject edilmeli.\",\n            \"test_assertion\": \"is_valid is False for all corruptions\",\n            \"test_metric\": \"corruption_detection = 100%\"\n          }\n        ]\n      },\n      \"security\": {\n        \"name\": \"🔒 Güvenlik Testleri\",\n        \"description\": \"Path traversal, malicious payloads, input validation\",\n        \"questions\": [\n          {\n            \"id\": \"sec_001\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Path traversal saldırıları bloke ediliyor mu? '../../etc/passwd' paketlenirse?\",\n            \"context\": {\n              \"attack_payloads\": [\n                \"../../etc/passwd\",\n                \"..\\\\..\\\\windows\\\\system32\",\n                \"/etc/passwd\",\n                \"C:\\\\Windows\\\\System32\\\\config\"\n              ]\n            },\n            \"expected_answer\": \"Validator bu zararlı path'leri reject etmeli.\",\n            \"test_assertion\": \"is_valid is False for all traversal paths\",\n            \"test_metric\": \"security_score = 100%\"\n          },\n          {\n            \"id\": \"sec_002\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Large-scale payloads (1000+ dosya) performans DoS'a karşı korunuyor mu?\",\n            \"context\": {\n              \"payload_scale\": \"1000 files x 1MB each\",\n              \"timeout\": \"< 5 seconds\",\n              \"memory_limit\": \"< 500MB\"\n            },\n            \"expected_answer\": \"Pack hızlı tamamlanmalı, memory leak yokmalı.\",\n            \"test_assertion\": \"elapsed < 5.0 and memory_usage < 500MB\",\n            \"test_metric\": \"dos_resilience = acceptable\"\n          }\n        ]\n      },\n      \"deterministic\": {\n        \"name\": \"🔄 Deterministik Davranış Testleri\",\n        \"description\": \"Aynı giriş → aynı çıktı doğrulaması\",\n        \"questions\": [\n          {\n            \"id\": \"deter_001\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Aynı dosya iki kez paketlenince checksum aynı mı?\",\n            \"context\": {\n              \"test_count\": 2,\n              \"file\": \"code.py with content 'def func(): pass'\"\n            },\n            \"expected_answer\": \"checksum1 == checksum2\",\n            \"test_assertion\": \"packet1.files[0].checksum == packet2.files[0].checksum\",\n            \"test_metric\": \"determinism = 100%\"\n          },\n          {\n            \"id\": \"deter_002\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"JSON serialization deterministic mi? İki to_dict() çağrısının SHA-256'ları eşleşiyor mu?\",\n            \"context\": {\n              \"calls\": 2,\n              \"hash_algo\": \"SHA-256\",\n              \"serialization\": \"json.dumps(sort_keys=True)\"\n            },\n            \"expected_answer\": \"hash1 == hash2 (tam bit-for-bit eşit olmalı)\",\n            \"test_assertion\": \"hashlib.sha256(json1.encode()) == hashlib.sha256(json2.encode())\",\n            \"test_metric\": \"json_determinism = 100%\"\n          }\n        ]\n      },\n      \"performance\": {\n        \"name\": \"⚡ Performans Testleri\",\n        \"description\": \"Ölçeklenebilirlik ve hız testleri\",\n        \"questions\": [\n          {\n            \"id\": \"perf_001\",\n            \"difficulty\": \"basic\",\n            \"question\": \"50 dosya paketleme kaç saniyede tamamlanıyor?\",\n            \"context\": {\n              \"file_count\": 50,\n              \"file_size\": \"1KB each\",\n              \"target_time\": \"< 1 second\"\n            },\n            \"expected_answer\": \"elapsed < 1.0 saniye\",\n            \"test_assertion\": \"elapsed < 1.0\",\n            \"test_metric\": \"throughput = 50+ files/sec\"\n          },\n          {\n            \"id\": \"perf_002\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"500 dosya ve 1000 decision paketleniyor mu?\",\n            \"context\": {\n              \"scale\": \"500 files + 1000 decisions + 500 symbols\",\n              \"target_time\": \"< 10 seconds\"\n            },\n            \"expected_answer\": \"Tüm ölçekler başarıyla paketlenmeli.\",\n            \"test_assertion\": \"len(packet.files) == 500 and len(packet.decisions) == 1000\",\n            \"test_metric\": \"scalability = passed\"\n          }\n        ]\n      },\n      \"edge_cases\": {\n        \"name\": \"🔍 Edge Case Testleri\",\n        \"description\": \"Sınır durumlar ve özel durumlar\",\n        \"questions\": [\n          {\n            \"id\": \"edge_001\",\n            \"difficulty\": \"basic\",\n            \"question\": \"Boş proje paketlenebiliyor mu?\",\n            \"context\": {\n              \"files\": 0,\n              \"decisions\": 0\n            },\n            \"expected_answer\": \"Boş paket oluşturulmalı, error yok.\",\n            \"test_assertion\": \"len(packet.files) == 0 and packet is not None\",\n            \"test_metric\": \"empty_handling = ok\"\n          },\n          {\n            \"id\": \"edge_002\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Geçersiz UTF-8 dosyası (b'\\\\xff\\\\xfe\\\\xfa') paketlenince ne oluyor?\",\n            \"context\": {\n              \"file_type\": \"binary/corrupted\",\n              \"handling\": \"error or skip\"\n            },\n            \"expected_answer\": \"Hata veya skip edilmeli, crash yok.\",\n            \"test_assertion\": \"exception caught or file skipped\",\n            \"test_metric\": \"error_resilience = ok\"\n          },\n          {\n            \"id\": \"edge_003\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"10MB single file paketlenebiliyor mu? Memory leak var mı?\",\n            \"context\": {\n              \"file_size\": \"10MB\",\n              \"memory_limit\": \"< 100MB\"\n            },\n            \"expected_answer\": \"Paketlenebilmeli, memory efficient olmalı.\",\n            \"test_assertion\": \"packet.files[0].size > 10*1024*1024\",\n            \"test_metric\": \"memory_efficiency = passed\"\n          }\n        ]\n      },\n      \"integration\": {\n        \"name\": \"🎯 Integration Testleri\",\n        \"description\": \"Gerçek dünya senaryoları\",\n        \"questions\": [\n          {\n            \"id\": \"int_001\",\n            \"difficulty\": \"intermediate\",\n            \"question\": \"Gerçek Python projesi (src/, tests/, docs/) başarıyla paketlenip restore ediliyor mu?\",\n            \"context\": {\n              \"structure\": \"Typical Python project layout\",\n              \"files\": 7,\n              \"decisions\": 1,\n              \"symbols\": 1\n            },\n            \"expected_answer\": \"Pack→Unpack→Verify workflow 100% başarılı olmalı.\",\n            \"test_assertion\": \"all assertions passed\",\n            \"test_metric\": \"integration_success = 100%\"\n          },\n          {\n            \"id\": \"int_002\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"Cross-model context transfer (Claude context → GPT'ye gönderme). Tüm data intact mi?\",\n            \"context\": {\n              \"source_model\": \"claude\",\n              \"target_model\": \"gpt-4\",\n              \"transfer_medium\": \"ACTP JSON file\"\n            },\n            \"expected_answer\": \"Tüm metadata, decisions, files intact kalmalı.\",\n            \"test_assertion\": \"all data fields present and valid\",\n            \"test_metric\": \"transfer_integrity = 100%\"\n          }\n        ]\n      },\n      \"concurrent\": {\n        \"name\": \"🔀 Concurrent/Thread Safety Testleri\",\n        \"description\": \"Multi-threaded packing operations\",\n        \"questions\": [\n          {\n            \"id\": \"conc_001\",\n            \"difficulty\": \"advanced\",\n            \"question\": \"20 thread'le concurrent pack yapılabilir mi? Race condition var mı?\",\n            \"context\": {\n              \"thread_count\": 20,\n              \"operations\": \"concurrent packing\",\n              \"error_tolerance\": 0\n            },\n            \"expected_answer\": \"Tüm thread'ler başarılı olmalı, 0 error.\",\n            \"test_assertion\": \"len(errors) == 0 and len(results) == 20\",\n            \"test_metric\": \"thread_safety = passed\"\n          }\n        ]\n      }\n    },\n    \"evaluation_rubric\": {\n      \"correctness\": {\n        \"weight\": 40,\n        \"criteria\": [\n          \"Test assertion'lar geçiyor mu?\",\n          \"Expected metric'ler sağlanıyor mu?\",\n          \"Edge case'ler handle ediliyor mu?\"\n        ]\n      },\n      \"performance\": {\n        \"weight\": 20,\n        \"criteria\": [\n          \"Zaman limitleri karşılanıyor mu?\",\n          \"Memory efficient mi?\",\n          \"Ölçeklenebilir mi?\"\n        ]\n      },\n      \"security\": {\n        \"weight\": 20,\n        \"criteria\": [\n          \"Path traversal bloke edildi mi?\",\n          \"Malicious payloads reddedildi mi?\",\n          \"DoS'a karşı korunmuş mu?\"\n        ]\n      },\n      \"determinism\": {\n        \"weight\": 15,\n        \"criteria\": [\n          \"Aynı input → aynı output mu?\",\n          \"JSON deterministic mi?\",\n          \"Checksum stabil mi?\"\n        ]\n      },\n      \"reliability\": {\n        \"weight\": 5,\n        \"criteria\": [\n          \"Hata handling iyi mi?\",\n          \"Unicode support var mı?\",\n          \"Corrupted packet handling?\"\n        ]\n      }\n    },\n    \"test_execution_results\": {\n      \"timestamp\": \"2026-07-21T12:00:00Z\",\n      \"total_questions\": 28,\n      \"by_difficulty\": {\n        \"basic\": 6,\n        \"intermediate\": 12,\n        \"advanced\": 10\n      },\n      \"by_category\": {\n        \"deduplikasyon\": 3,\n        \"round_trip\": 4,\n        \"validator\": 4,\n        \"security\": 2,\n        \"deterministic\": 2,\n        \"performance\": 2,\n        \"edge_cases\": 3,\n        \"integration\": 2,\n        \"concurrent\": 1\n      },\n      \"expected_metrics\": {\n        \"coverage\": \"85-90%\",\n        \"pass_rate\": \"95%+\",\n        \"performance_score\": \"acceptable\",\n        \"security_score\": \"95%+\"\n      }\n    },\n    \"ai_prompts\": {\n      \"claude\": {\n        \"system_prompt\": \"You are an ACTP (Agent Context Transfer Protocol) expert. Review the test suite and validate the implementation. Focus on deduplikasyon, round-trip integrity, and validator correctness.\",\n        \"task\": \"Execute the test suite mentally and identify any failures or edge cases not covered.\"\n      },\n      \"gpt4\": {\n        \"system_prompt\": \"You are a security architect. Review ACTP tests for security vulnerabilities, path traversal, and DoS resilience.\",\n        \"task\": \"Perform security audit of the test suite and identify gaps.\"\n      },\n      \"gemini\": {\n        \"system_prompt\": \"You are a performance engineer. Review ACTP tests for scalability and deterministic behavior.\",\n        \"task\": \"Analyze performance benchmarks and identify optimization opportunities.\"\n      }\n    },\n    \"next_steps\": [\n      \"Run pytest on test_comprehensive.py and test_advanced_security.py\",\n      \"Fix the 2 failing tests (binary detection, nested paths)\",\n      \"Run full test suite with coverage report\",\n      \"Submit to Claude/GPT-4/Gemini for cross-model validation\",\n      \"Generate coverage report and compare with 85-90% target\"\n    ]\n  }\n}\n",
