      "path": "actp-codegraphref.patch",
      "content": "diff --git a/actp.schema.json b/actp.schema.json\nindex 63ec352..fd1529b 100644\n--- a/actp.schema.json\n+++ b/actp.schema.json\n@@ -137,6 +137,35 @@\n           \"type\": \"array\",\n           \"items\": { \"type\": \"string\" },\n           \"description\": \"URLs or filenames. Mark with 🔗 if external dependency.\"\n+        },\n+        \"code_graph_ref\": {\n+          \"type\": \"object\",\n+          \"description\": \"Optional reference to a precomputed structural code graph (e.g. Graphify output). Complements ACTP's declarative decision memory with structural/dependency memory. Only a reference is stored — never the graph itself — to keep packets lightweight.\",\n+          \"required\": [\"tool\", \"graph_path\"],\n+          \"properties\": {\n+            \"tool\": {\n+              \"type\": \"string\",\n+              \"description\": \"Name of the graph-generation tool used.\",\n+              \"examples\": [\"graphify\"]\n+            },\n+            \"graph_path\": {\n+              \"type\": \"string\",\n+              \"description\": \"Relative path to the graph file (e.g. graph.json) within the project.\"\n+            },\n+            \"graph_hash\": {\n+              \"type\": \"string\",\n+              \"description\": \"SHA-256 hash of the graph file. Used by the receiving model to detect staleness before trusting the reference.\"\n+            },\n+            \"generated_at\": {\n+              \"type\": \"string\",\n+              \"format\": \"date-time\",\n+              \"description\": \"Timestamp when the graph was last built.\"\n+            },\n+            \"node_count\": {\n+              \"type\": \"integer\",\n+              \"description\": \"Number of nodes in the graph. Below ~500 files, consumers may reasonably skip resolving this reference since the graph adds more overhead than value at small scale.\"\n+            }\n+          }\n         }\n       }\n     },\ndiff --git a/cli/src/index.ts b/cli/src/index.ts\nindex 78a7b7d..fdd4fca 100644\n--- a/cli/src/index.ts\n+++ b/cli/src/index.ts\n@@ -64,6 +64,25 @@ program\n         console.log(`\\n?? Next Steps:`);\n         raw.next_steps.forEach((s, i) => console.log(`  ${i + 1}. ${s}`));\n       }\n+      const graphRef = raw.artifacts && raw.artifacts.code_graph_ref;\n+      if (graphRef) {\n+        console.log(`\\n?? Code Graph:`);\n+        console.log(`  tool: ${graphRef.tool} | path: ${graphRef.graph_path}`);\n+        if (graphRef.node_count !== undefined) {\n+          const note = graphRef.node_count < 500 ? \" (below 500-file threshold - resolving may not be worth it)\" : \"\";\n+          console.log(`  nodes: ${graphRef.node_count}${note}`);\n+        }\n+        if (graphRef.graph_hash) {\n+          const localPath = path.resolve(path.dirname(filePath), graphRef.graph_path);\n+          if (fs.existsSync(localPath)) {\n+            const crypto = require(\"crypto\");\n+            const currentHash = crypto.createHash(\"sha256\").update(fs.readFileSync(localPath)).digest(\"hex\");\n+            console.log(currentHash === graphRef.graph_hash ? `  status: up to date` : `  status: STALE - graph changed since packet was created`);\n+          } else {\n+            console.log(`  status: graph file not found at ${localPath}`);\n+          }\n+        }\n+      }\n       console.log(`${\"\".repeat(50)}\\n`);\n     } catch { console.error(`? Failed to parse packet`); process.exit(1); }\n   });\ndiff --git a/cli/src/types.ts b/cli/src/types.ts\nindex e68303d..8d9a6ca 100644\n--- a/cli/src/types.ts\n+++ b/cli/src/types.ts\n@@ -18,9 +18,18 @@ export interface ACTPTask {\n   symbol?: string;\n }\n \n+export interface ACTPCodeGraphRef {\n+  tool: string;\n+  graph_path: string;\n+  graph_hash?: string;\n+  generated_at?: string;\n+  node_count?: number;\n+}\n+\n export interface ACTPArtifacts {\n   code_snippets?: Array<{ id: string; lang: string; content: string; summary?: string }>;\n   references?: string[];\n+  code_graph_ref?: ACTPCodeGraphRef;\n }\n \n export interface ACTPPacket {\n",
