    {
      "path": "benchmarks/sessions/archive/actp-unified-v1.1.json",
      "content": "{\n  \"packet_meta\": {\n    \"format\": \"ACTP-unified-v1.1\",\n    \"created\": \"2026-04-16\",\n    \"origin_model\": \"Claude (Anthropic)\",\n    \"session_type\": \"unified_master_packet\",\n    \"purpose\": \"Complete project memory — ACTP spec + Maestro app + all benchmarks\",\n    \"instruction\": \"Paste this JSON to continue from full project history.\",\n    \"child_packets\": [\n      \"actp-spec-session-v0.4\",\n      \"actp-readme-export-v0.1\",\n      \"maestro-ui-v0.2\"\n    ],\n    \"symbol_legend\": {\n      \"🔴\": \"priority=P0, mutability=LOCKED, certainty=HIGH\",\n      \"🟡\": \"priority=P1, mutability=FLEXIBLE, certainty=MEDIUM\",\n      \"🔵\": \"priority=P2, mutability=FLEXIBLE, certainty=LOW\",\n      \"🟢\": \"status=COMPLETED\",\n      \"🌫️\": \"certainty=LOW, hallucination_risk=true\",\n      \"🔗\": \"external_dependency=true\"\n    }\n  },\n\n  \"projects\": {\n    \"actp_spec\": {\n      \"name\": \"AI Context Transfer Protocol (ACTP)\",\n      \"tagline\": \"Don't explain your project again. Just transfer it.\",\n      \"github\": \"https://github.com/samiboran/actp-spec\",\n      \"local_path\": \"C:\\\\Users\\\\pc\\\\Desktop\\\\actp-spec\",\n      \"status\": \"CLI v0.1 complete, BENCH-001 + BENCH-002 complete\",\n      \"visibility\": \"private\",\n\n      \"core_concept\": {\n        \"symbol\": \"🔴\",\n        \"definition\": \"Portable AI context packets that transfer full project understanding between different AI models without re-explaining.\",\n        \"analogy\": \"Git for AI memory — versioned, portable, model-agnostic\",\n        \"NOT\": \"Blockchain, cloud memory, provider-specific tool\"\n      },\n\n      \"core_principles\": [\n        \"Model-agnostic — works with Claude, ChatGPT, Gemini, or any future model\",\n        \"User-owned — no cloud dependency, your data lives where you put it\",\n        \"Semantic, not raw — captures decisions and state, not raw transcripts\",\n        \"Dual-layer encoding — machine-readable fields + human-readable symbols\",\n        \"Delta sync — only meaningful changes propagate\"\n      ],\n\n      \"validated_decisions\": [\n        { \"id\": \"D1\", \"symbol\": \"🔴\", \"decision\": \"ACTP must be model-agnostic\" },\n        { \"id\": \"D2\", \"symbol\": \"🔴\", \"decision\": \"Structured fields primary, symbols secondary\" },\n        { \"id\": \"D3\", \"symbol\": \"🔴\", \"decision\": \"JSON-LD @context namespace adopted\" },\n        { \"id\": \"D4\", \"symbol\": \"🔴\", \"decision\": \"vocabulary_hash required in every packet\" },\n        { \"id\": \"D5\", \"symbol\": \"🟡\", \"decision\": \"Open standard free, Compressor SaaS paid\" },\n        { \"id\": \"D6\", \"symbol\": \"🟡\", \"decision\": \"MCP = transport layer, ACTP = payload layer\" },\n        { \"id\": \"D9\", \"symbol\": \"🔴\", \"decision\": \"Conflict resolution: branch-both + vector clocks\" },\n        { \"id\": \"D11\", \"symbol\": \"🔴\", \"decision\": \"Format C (ACTP symbolic) is recommended default\" },\n        { \"id\": \"D12\", \"symbol\": \"🔴\", \"decision\": \"Explicit anti-patterns fix model violations — constraint quality determines compliance\" }\n      ],\n\n      \"symbolic_layer\": {\n        \"description\": \"Two-layer encoding inspired by Method of Loci and von Restorff Effect\",\n        \"layer_1\": \"Structured fields — machine-readable, primary\",\n        \"layer_2\": \"Symbolic markers — human-readable, secondary\",\n        \"note\": \"High-entropy tokens like 🔴 increase attention weight in transformers (von Restorff Effect)\"\n      },\n\n      \"node_architecture\": {\n        \"spec_name\": \"ACTP-N\",\n        \"node_types\": [\n          \"Local Node — creates/consumes packets\",\n          \"Relay Node — MCP-based delta transport\",\n          \"Snapshot Node — compressed stable state\",\n          \"Refutation Node ⚔️ — conflict detection\"\n        ],\n        \"sync\": \"Event-driven delta sync\",\n        \"conflict_resolution\": \"branch-both + vector clocks, P0 tie = human-in-the-loop\"\n      },\n\n      \"cli_status\": {\n        \"symbol\": \"🟢\",\n        \"version\": \"0.1.0\",\n        \"commands\": [\"actp init\", \"actp validate\", \"actp summary\"],\n        \"in_progress\": \"CLI v0.2: capture and rehydrate commands\",\n        \"run_command\": \"npm run dev -- <command>\"\n      },\n\n      \"benchmarks\": {\n        \"BENCH-001\": {\n          \"symbol\": \"🟢\",\n          \"constraint\": \"Model-agnostic, no provider SDK\",\n          \"results\": {\n            \"claude\": \"3/3 PASS\",\n            \"chatgpt\": \"3/3 PASS\",\n            \"gemini\": \"0/3 FAIL (hardcoded OpenAI response shape)\"\n          },\n          \"finding\": \"Format C produces best code architecture. Format alone cannot guarantee constraint following.\"\n        },\n        \"BENCH-002\": {\n          \"symbol\": \"🟢\",\n          \"constraint\": \"Same + explicit anti-pattern list with provider attribution\",\n          \"results\": {\n            \"claude\": \"4/4 PASS\",\n            \"chatgpt\": \"4/4 PASS\",\n            \"gemini\": \"4/4 PASS\"\n          },\n          \"finding\": \"Explicit anti-patterns fixed Gemini: 0/4 → 4/4. Gemini internalized ACTP as native protocol.\"\n        }\n      },\n\n      \"repo_files\": [\n        \"README.md\",\n        \"actp.schema.json\",\n        \"cli/src/index.ts\",\n        \"cli/src/packet.ts\",\n        \"cli/src/types.ts\",\n        \"benchmarks/BENCH-002.md\"\n      ]\n    },\n\n    \"maestro\": {\n      \"name\": \"Maestro\",\n      \"tagline\": \"Multi-model AI orchestrator\",\n      \"github\": \"https://github.com/samiboran/maestro\",\n      \"local_path\": \"C:\\\\Users\\\\pc\\\\Desktop\\\\maestro\",\n      \"status\": \"v0.2 pushed\",\n      \"stack\": \"React + Vite + Cloudflare Workers\",\n\n      \"completed\": [\n        \"✅ Beyaz tema (#faf9f7 bg, #9a7a4a gold)\",\n        \"✅ DraggablePanel.jsx komponenti\",\n        \"✅ Snap noktaları (sol %15, sağ %85, alt-merkez %50)\",\n        \"✅ transform: translate(-50%, -50%) positioning fix\",\n        \"✅ Prompt kutusu genişletildi (560px, auto-resize height)\",\n        \"✅ GitHub push başarılı\"\n      ],\n\n      \"current_ui\": {\n        \"theme\": \"beyaz\",\n        \"panels\": {\n          \"claude\": { \"snap\": \"left\", \"position\": \"15%, 35%\" },\n          \"chatgpt\": { \"snap\": \"right\", \"position\": \"85%, 35%\" },\n          \"gemini\": { \"snap\": \"bottom-center\", \"position\": \"50%, 85%\" }\n        },\n        \"prompt_box\": {\n          \"width\": \"560px\",\n          \"border_radius\": \"24px\",\n          \"auto_resize\": \"height only\"\n        }\n      },\n\n      \"file_structure\": {\n        \"src/App.jsx\": \"Ana layout\",\n        \"src/App.css\": \"Beyaz tema stiller\",\n        \"src/components/DraggablePanel.jsx\": \"Sürüklenebilir panel + snap\",\n        \"src/ApiKeyModal.jsx\": \"API key giriş modalı\",\n        \"src/config.js\": \"WORKER_URL\"\n      },\n\n      \"known_issue\": {\n        \"problem\": \"ACTP JSON üret butonu 'Failed to fetch' hatası veriyor\",\n        \"likely_cause\": \"Cloudflare Worker not deployed or CORS issue\"\n      }\n    }\n  },\n\n  \"business_model\": {\n    \"model\": \"Git + GitHub pattern\",\n    \"tiers\": [\n      { \"layer\": \"Schema + CLI\", \"price\": \"Free / Open source\" },\n      { \"layer\": \"Compressor SaaS\", \"price\": \"~$10-20/mo\" },\n      { \"layer\": \"Enterprise\", \"price\": \"~$100-500/mo\" }\n    ],\n    \"philosophy\": \"The protocol is open. The tooling is where value is captured.\"\n  },\n\n  \"business_research\": {\n    \"competitor\": \"Magai\",\n    \"magai_stats\": {\n      \"founded\": \"2023\",\n      \"founder\": \"Dustin Stout (solo)\",\n      \"revenue_2024\": \"$588.1K\",\n      \"users\": \"50,000+\",\n      \"funding\": \"$0 (bootstrapped)\"\n    },\n    \"maestro_differentiation\": [\n      \"ACTP protokolü (context transfer)\",\n      \"Consensus engine\",\n      \"Ücretsiz tier\"\n    ]\n  },\n\n  \"three_model_contributions\": {\n    \"claude\": \"Synthesis, schema, CLI, session orchestration, benchmark design + analysis\",\n    \"chatgpt\": \"Machine-first architecture, dual-layer encoding, event-driven sync, conflict branching, mirror effect discovery\",\n    \"gemini\": \"Von Restorff Effect, JSON-LD, vocabulary_hash, hallucination flag 🌫️, Gossip protocol, DHT, vector clocks, Refutation Node ⚔️, ACTP-native namespace internalization\"\n  },\n\n  \"roadmap\": {\n    \"completed\": [\n      \"🟢 Core concept validated\",\n      \"🟢 v0.1 schema draft\",\n      \"🟢 Symbolic encoding layer\",\n      \"🟢 Node architecture spec (ACTP-N)\",\n      \"🟢 CLI v0.1: init, validate, summary\",\n      \"🟢 BENCH-001: 3 models × 3 formats\",\n      \"🟢 BENCH-002: Anti-patterns fix Gemini\",\n      \"🟢 Maestro UI v0.2\"\n    ],\n    \"in_progress\": [\n      \"🟡 CLI v0.2: capture and rehydrate commands\"\n    ],\n    \"next_tasks\": {\n      \"actp_spec\": [\n        { \"id\": \"A1\", \"symbol\": \"🟡\", \"task\": \"CLI v0.2: capture + rehydrate\" },\n        { \"id\": \"A2\", \"symbol\": \"🟡\", \"task\": \"Compressor Agent\" },\n        { \"id\": \"A3\", \"symbol\": \"🔵\", \"task\": \"actp.dev spec site\" }\n      ],\n      \"maestro\": [\n        { \"id\": \"M1\", \"symbol\": \"🔴\", \"task\": \"Fix Worker fetch error\" },\n        { \"id\": \"M2\", \"symbol\": \"🔴\", \"task\": \"Prompt kutusu width auto-resize\" },\n        { \"id\": \"M3\", \"symbol\": \"🔴\", \"task\": \"Sol sidebar (Claude benzeri)\" },\n        { \"id\": \"M4\", \"symbol\": \"🟡\", \"task\": \"Ücretsiz modeller (Groq, Gemini Free)\" },\n        { \"id\": \"M5\", \"symbol\": \"🟡\", \"task\": \"Cloudflare Pages deploy\" },\n        { \"id\": \"M6\", \"symbol\": \"🔵\", \"task\": \"Mobile responsive\" }\n      ]\n    }\n  },\n\n  \"proof_of_concept\": {\n    \"symbol\": \"🟢\",\n    \"summary\": \"Entire ACTP development process was itself a live ACTP demo. JSON packets carried context between Claude, ChatGPT, and Gemini across multiple sessions. CLI built and tested. Two benchmarks complete (9 + 12 = 21 tests across 3 models). Maestro UI v0.2 functional.\",\n    \"verdict\": \"Core concept validated. Both benchmarks prove constraint following works. Automation next.\"\n  }\n}\n",
